# Keep the build context minimal and free of local configuration — a stray
# .env would otherwise be copied into the image.
.env
.env.*
!.env.example

.git
.gitignore
.venv
__pycache__
*.pyc
.pytest_cache
.ruff_cache
htmlcov
.coverage

Dockerfile
.dockerignore
docker-compose.yml
charts
infrastructure
tests
scripts-*.sh
scripts-*.py
