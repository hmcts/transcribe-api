#!groovy

@Library("Infrastructure@2.13.4")

def type = "python"
def product = "transcribe"
def component = "api"

// Runtime secrets are mounted from Key Vault by the Helm chart (see
// charts/transcribe-api/values.yaml). This block is the separate, build-time
// mechanism: it pulls a secret into the Jenkins environment so it can be
// substituted into values.{env}.template.yaml. Only App Insights uses it. The
// chart also mounts the same secret from Key Vault (values.yaml), which is how
// the worker gets it; hmcts-otel reads either from the environment.
def secrets = [
  'transcribe-${env}': [
    secret('AppInsightsConnectionString', 'APP_INSIGHTS_CONNECTION_STRING'),
  ]
]

static LinkedHashMap<String, Object> secret(String secretName, String envVar) {
  [ $class: 'AzureKeyVaultSecret',
    secretType: 'Secret',
    name: secretName,
    version: '',
    envVariable: envVar
  ]
}

// docs:
// 1. https://github.com/hmcts/cnp-jenkins-library
// 2. https://hmcts.github.io/ways-of-working/common-pipeline/common-pipeline.html#common-pipeline
withPipeline(type, product, component) {
  loadVaultSecrets(secrets)

  // AKS only. There is no App Service deployment for this product.
  disableLegacyDeployment()

  // The image's version (runtime/version.py). The pipeline's `az acr build` takes no
  // build arguments of ours, so the commit goes in as a file beside the source.
  before('dockerbuild') {
    writeFile file: 'src/transcribe_api/runtime/BUILD_VERSION', text: env.GIT_COMMIT.substring(0, 7)
  }

  // DIAAT-287: the prohibited-content (PII) scan of the validation scenarios' telemetry,
  // written by the unit tests, kept with the build as release evidence.
  afterAlways('test') {
    archiveArtifacts allowEmptyArchive: true, artifacts: 'test-results/telemetry-pii-scan.json'
  }

  // Keep the long-lived environment branches in step with master so a deploy
  // to demo/ithc/perftest is never built from stale code.
  syncBranchesWithMaster(['demo', 'ithc', 'perftest'])
}
