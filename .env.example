# HMCTS Transcribe backend — local configuration.
# Copy to .env for local development. Never commit .env (see .gitignore).
# In deployed environments these arrive from Key Vault via the chart's
# keyVaults block, NOT from a file — see charts/transcribe-api/values.yaml.

ENVIRONMENT=local
APP_URL=http://localhost:3000
API_PORT=8080

# --- database (docker compose provides this locally) ---
DATABASE_CONNECTION_STRING=postgresql://transcribe:transcribe@localhost:5432/transcribe

# --- MoJ Entra (e-judiciary) ---
AZURE_AD_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_AD_TENANT_ID=00000000-0000-0000-0000-000000000000
# Local dev only: skip real token verification.
JWT_ENABLE_VERIFICATION=false
JWT_VERIFICATION_STRICT=false

# --- storage (azurite provides this locally) ---
AZURE_STORAGE_ACCOUNT_NAME=devstoreaccount1
AZURE_STORAGE_CONTAINER_NAME=audio-uploads
AZURE_STORAGE_TRANSCRIPTION_CONTAINER=transcriptions

# --- azure speech (blank disables; set to exercise transcription) ---
AZURE_SPEECH_ENDPOINT=
AZURE_SPEECH_KEY=

# --- optional integrations, all disabled locally ---
SENTRY_DSN=
GOV_NOTIFY_API_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
DISABLE_FASTAPI_INSTRUMENTATION=true

# Background pollers run in the separate worker workload, not the API process.
# See architecture 4.3 and src/transcribe_api/worker.py
RUN_WORKERS=false
